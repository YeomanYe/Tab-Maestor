{
  "name": "Tab Maestro",
  "version": "1.0.0",
  "description": "A Chrome extension for saving and managing browser tabs with automatic saving rules.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"vite\" \"pnpm build:watch\"",
    "build": "tsc && vite build",
    "build:watch": "tsc --watch --noEmit & vite build --watch",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:style:fix": "stylelint \"src/**/*.scss\" --fix",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "prettier": "^3.1.1",
    "sass": "^1.69.5",
    "stylelint": "^17.3.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-chrome-extension": "^0.0.1",
    "vitest": "^1.1.0"
  },
  "packageManager": "pnpm@10.29.3"
}
